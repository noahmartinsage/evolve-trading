# EVOLVE orchestration 服务环境变量样例
# 复制为 .env（勿提交真实密钥）。所有密钥仅允许通过环境变量/密管系统注入，
# 禁止写入代码、日志、API 响应或任何仓库文件。

# ── 访问控制 ────────────────────────────────────────────────
# 写操作令牌（POST/DELETE 必带 x-orch-token 头）。
# NODE_ENV=production 时未设置将拒绝启动（fail-closed）。
ORCH_TOKEN=change-me-to-a-long-random-secret

# CORS 白名单（生产必须收敛，逗号分隔多个来源；默认 * 仅限本地开发）
# ORCH_ALLOWED_ORIGIN=https://console.example.com

# ── 服务基础 ────────────────────────────────────────────────
PORT=8787
# 订阅交易对（逗号分隔）
ORCH_SYMBOLS=ETHUSDT,BTCUSDT
ORCH_INTERVAL=1m
# 行情 REST 镜像（公开数据，无密钥）
BINANCE_REST=https://data-api.binance.vision

# ── 持久化与保留策略 ────────────────────────────────────────
# SQLite 账本文件（WAL 模式；事件追加写 + 审计哈希链）
ORCH_DB=data/orch.db
# 事件保留天数（先归档 JSONL 再清理；0 = 关闭清理）
ORCH_RETENTION_DAYS=90

# ── Venue 接入（live 出站唯一通道 execution-gateway） ───────
# sandbox：故障注入沙盒（默认，无外部副作用）
# cex-testnet：Binance 现货测试网（凭证缺失则 fail-closed 不挂载）
VENUE=sandbox
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_REST=https://testnet.binance.vision

# ⚠️ 小资金受控实盘前置条件（全部满足才允许 VENUE 指向真实 venue）：
# 1. 策略已走完晋升链并被人工审批（stage=small_cap_live，capUsd 硬上限生效）
# 2. killswitch 故障演练记录归档（npm run test:gateway + artifacts/drill-latest.json）
# 3. 审计哈希链校验开启监控（GET /audit/verify）
# 4. SLO 基线建立（GET /metrics 采样 ≥7 天）
